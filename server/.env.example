# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration
# If PGHOST is unreachable or USE_EMBEDDED_POSTGRES=true,
# the backend seamlessly uses Postgres WASM (PGlite) with identical schema, triggers & views.
USE_EMBEDDED_POSTGRES=auto
PGHOST=localhost
PGPORT=5432
PGDATABASE=disaster_relief
PGUSER=postgres
PGPASSWORD=postgres

# PostgreSQL Connection Pool Limits (Optimized for Emergency Spikes)
PG_POOL_MAX=20
PG_POOL_IDLE_TIMEOUT=30000
PG_POOL_CONNECTION_TIMEOUT=5000
